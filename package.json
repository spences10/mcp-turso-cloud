{
	"name": "mcp-turso-cloud",
	"version": "0.0.11",
	"description": "MCP server for integrating Turso with LLMs",
	"keywords": [
		"ai",
		"database",
		"embeddings",
		"libsql",
		"llm",
		"mcp",
		"model-context-protocol",
		"similarity-search",
		"sql",
		"sqlite",
		"turso",
		"vector-database",
		"vector-search"
	],
	"license": "MIT",
	"author": "Scott Spence",
	"bin": {
		"mcp-turso-cloud": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "vp pack && chmod +x dist/index.js",
		"start": "node dist/index.js",
		"dev": "vp pack --watch",
		"inspect": "pnpx @modelcontextprotocol/inspector dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"test": "pnpm run build && vp test",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish",
		"sync-server-json": "node -e \"const pkg = require('./package.json'); const server = require('./server.json'); server.version = pkg.version; server.packages[0].version = pkg.version; require('fs').writeFileSync('./server.json', JSON.stringify(server, null, 2));\"",
		"publish-mcp": "pnpm run sync-server-json && mcp-publisher publish"
	},
	"dependencies": {
		"@libsql/client": "catalog:",
		"@tmcp/adapter-zod": "catalog:",
		"@tmcp/transport-stdio": "catalog:",
		"tmcp": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"packageManager": "pnpm@12.8.1",
	"mcpName": "io.github.spences10/mcp-turso-cloud"
}
